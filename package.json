{
  "name": "@local/dsh-done-notify",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Notifies you when a conversation finishes running — in-app toast, system notifications, and a Settings page to configure them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqstrong/dsh-done-notify.git"
  },
  "homepage": "https://github.com/jqstrong/dsh-done-notify#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "notification",
    "desktop"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node check.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
